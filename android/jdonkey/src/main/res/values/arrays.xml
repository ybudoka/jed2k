<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Entries for the Theme preference. The values must match the THEME_* constants in
      org.dkf.jmule.Constants, which is what NightMode reads back.
    -->
    <string-array name="theme_entries">
        <item>@string/theme_system</item>
        <item>@string/theme_light</item>
        <item>@string/theme_dark</item>
    </string-array>

    <string-array name="theme_values" translatable="false">
        <item>system</item>
        <item>light</item>
        <item>dark</item>
    </string-array>

</resources>
