<resources>

    <!--
      Palette refresh.

      The previous values were straight out of the Holo era: a muddy slate blue,
      #33b5e5 as the accent, and greys (#b5b5b5 for "light" text, #686868 for
      secondary) that fall short of the WCAG AA contrast ratio on the light grey
      body background. Several entries were also accidentally translucent -
      basic_gray_lighter was #f5f5f7f8, i.e. 96% alpha rather than opaque.

      The values below keep the app's navy identity but are deeper, cleaner and
      consistently related to one another. Every resource *name* is unchanged, so
      layouts, drawables and colour state lists all pick this up untouched.
    -->

    <!-- Basic colors -->
    <color name="basic_white">@android:color/white</color>
    <color name="basic_blue">#ff20415c</color>
    <color name="basic_blue_highlight">#ff29b6f6</color>
    <color name="basic_blue_highlight_dark">#ff0277b6</color>
    <color name="basic_blue_darker_highlight">#ff0277bd</color>
    <color name="basic_blue_transparent">#6629b6f6</color>
    <color name="basic_blue_dark">#ff152b3e</color>
    <color name="basic_blue_dark_highlight">#ff0f2130</color>
    <color name="basic_gray">#ffeceff1</color>
    <color name="basic_gray_lighter">#fff7f9fa</color>
    <color name="basic_yellow">#ffffe08a</color>
    <color name="basic_green">#ff12b886</color>
    <color name="basic_green_dark">#ff08805b</color>
    <color name="basic_gray_light">#fff2f4f6</color>
    <color name="basic_gray_medium">#ffe3e7ea</color>
    <color name="basic_gray_dark">#ffb0b8bf</color>
    <color name="basic_gray_text_dark">#ff1c2b36</color>
    <color name="basic_gray_text_medium">#ff5c6b78</color>
    <color name="basic_gray_text_light">#ff8b96a1</color>

    <!-- General app colors -->
    <color name="app_text_secondary_dark">#ff44525e</color>
    <color name="action_bar_background">@color/basic_blue</color>
    <color name="body_background_white">@color/basic_white</color>
    <color name="body_background_gray">@color/basic_gray</color>
    <color name="body_background_gray_light">@color/basic_gray_lighter</color>

    <!-- GENERAL APP COLORS -->
    <!-- Background Colors -->
    <color name="app_background_white">@color/basic_white</color>
    <color name="app_background">@color/basic_blue</color>
    <color name="app_background_dark">@color/basic_blue_dark</color>
    <color name="app_background_dark_highlight">@color/basic_blue_dark_highlight</color>
    <color name="app_background_body_light">@color/basic_gray_light</color>
    <color name="app_background_body_dark">@color/basic_gray_medium</color>
    <color name="app_toolbar_background">@color/basic_blue</color>
    <color name="app_toolbar_background_bottom">@color/basic_blue_dark_highlight</color>
    <color name="app_selection_background">@color/basic_gray_light</color>
    <color name="app_rich_notification_background">@color/basic_yellow</color>
    <color name="app_browse_thumbnail_background">@color/basic_gray_medium</color>
    <color name="app_grid_selected_background">@color/basic_blue_transparent</color>

    <!-- Other colors (old) -->
    <color name="frostwire_light_blue">#ff8ad9f5</color>

    <!-- General application colors -->
    <color name="app_dark_blue">#ff152b3e</color>
    <color name="app_dark_blue_highlight">#ff0f2130</color>
    <color name="app_dark_blue_selector">#ff1a3448</color>
    <color name="app_light_background">#fffafbfc</color>
    <color name="app_highlight_text">@color/basic_blue_highlight_dark</color>
    <color name="app_list_cell_line">#ffe1e6ea</color>
    <color name="app_menu_item_line">#ff1a3448</color>
    <color name="app_light_gray_text">#ffd5dde4</color>
    <color name="app_dark_grey_text">#ff5f6c77</color>

    <color name="browse_peer_listview_item_inactive_foreground">@color/app_dark_grey_text</color>

    <!-- pure #ff0000 is needlessly harsh on a light background -->
    <color name="warning_red">#ffe03131</color>

    <color name="transparent">#00000000</color>

    <!-- Black -->
    <color name="black">#ff000000</color>

    <!-- White -->
    <color name="white">#ffffffff</color>

    <!-- Hairline separators. These used to be spelled out as literal hex values
         (#ff1d2934) inside the layouts. -->
    <color name="app_divider_dark">#ff1a3448</color>
    <color name="app_divider_light">@color/app_list_cell_line</color>

    <!-- Text-input surface and hint. Previously @android:color/white and a literal
         #ffbfcfdc inside the layouts, both of which break under a dark theme. -->
    <color name="app_input_background">@color/basic_white</color>
    <color name="app_text_hint">#ff68757f</color>

    <!-- Row press / selection wash, was a literal #ffe0e7ed in the drawable -->
    <color name="app_pressed_background">#ffe0e7ed</color>

    <!-- Per-state accents for the transfers list -->
    <color name="transfer_state_downloading">@color/basic_blue_highlight_dark</color>
    <color name="transfer_state_completed">@color/basic_green_dark</color>
    <color name="transfer_state_stalled">#ffa06400</color>
    <color name="transfer_state_paused">@color/app_text_secondary</color>

    <!-- Text Colors -->
    <color name="app_text_primary">@color/basic_gray_text_dark</color>
    <color name="app_text_secondary">@color/basic_gray_text_medium</color>
    <color name="app_text_disabled">@color/basic_gray_text_light</color>
    <color name="app_text_white">@color/basic_white</color>
    <color name="app_text_light">@color/basic_gray_text_light</color>
    <color name="app_text_highlight">@color/basic_blue_highlight_dark</color>
    <color name="app_text_wizard">#ffb3bcc4</color>
    <color name="app_text_wizard_dark">#ff7c8892</color>

    <!-- Other colors (old) -->
    <color name="frostwire_orange">#ffe9a54c</color>
    <color name="frostwire_gray_explanation_text">#ffb3bcc4</color>
    <color name="frostwire_gray_explanation_text_dark">#ff7c8892</color>
    <!-- The action bar title color -->
    <color name="action_bar_title">@color/white</color>
</resources>
