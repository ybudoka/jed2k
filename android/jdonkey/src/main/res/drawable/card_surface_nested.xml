<?xml version="1.0" encoding="utf-8"?>
<!--
  Surface for a row nested inside an expanded card - the peers of a transfer. Same
  shape language as a card, but it sits on the page tone rather than the card tone so
  the hierarchy reads without a second border competing with the one above it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_card_background" />
    <stroke
        android:width="1dp"
        android:color="@color/app_card_stroke" />
    <corners android:radius="@dimen/card_radius" />
</shape>
