<?xml version="1.0" encoding="utf-8"?>
<!--
  A list row at rest. Rounded, one shade above the page, with a hairline that carries
  the edge where the fill alone is too close to the background to show it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_card_background" />
    <stroke
        android:width="1dp"
        android:color="@color/app_card_stroke" />
    <corners android:radius="@dimen/card_radius" />
</shape>
