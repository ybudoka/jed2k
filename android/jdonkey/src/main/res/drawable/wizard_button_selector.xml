<?xml version="1.0" encoding="utf-8"?>
<!--
  Hovered states are listed alongside the pressed/focused ones so a pointer that is
  aimed at something says so before it is clicked. Phones have no hover, so these
  items simply never match there; a headset controller's raycast, a mouse and a
  stylus all produce hover, and without them the app gave no feedback at all until
  the trigger was already pulled.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active tab -->
    <item android:drawable="@drawable/wizard_button_off" android:state_focused="false" android:state_pressed="false" android:state_selected="true"/>
    <!-- Inactive tab -->
    <item android:drawable="@drawable/wizard_button_off" android:state_focused="false" android:state_pressed="false" android:state_selected="false"/>
    <!-- Pressed tab -->
    <item android:drawable="@drawable/wizard_button_on" android:state_pressed="true"/>
    <item android:drawable="@drawable/wizard_button_on" android:state_hovered="true"/>
    <!-- Selected tab (using d-pad) -->
    <item android:drawable="@drawable/wizard_button_on" android:state_focused="true" android:state_pressed="false" android:state_selected="true"/>

</selector>