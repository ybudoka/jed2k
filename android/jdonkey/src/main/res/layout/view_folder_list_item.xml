<?xml version="1.0" encoding="utf-8"?>
<!--
  One folder: what it is for, where it is, and what can be done with it. Same card
  language as the transfer and search rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/card_gutter"
    android:paddingRight="@dimen/card_gutter"
    android:paddingTop="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_surface"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/view_folder_list_item_role"
            style="@style/ListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/dummy_title" />

        <TextView
            android:id="@+id/view_folder_list_item_path"
            style="@style/ListItemExt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            tools:text="@string/dummy_summary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/view_folder_list_item_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textSize="@dimen/text_x_small"
                android:text="@string/folders_scan" />

            <Button
                android:id="@+id/view_folder_list_item_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:textSize="@dimen/text_x_small"
                android:visibility="gone"
                android:text="@string/folders_remove" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
