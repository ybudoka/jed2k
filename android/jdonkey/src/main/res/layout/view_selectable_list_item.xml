<!--
  Generic wrapper AbstractListAdapter puts around every row, carrying the hidden
  selection checkbox.

  It used to paint listview_item_background: an opaque body-coloured slab with a
  hairline separator. Rows are cards on a page now, and that slab sat *behind* each
  card - filling the gutter with the card colour and drawing a separator between two
  things that are already visibly separate. The row's own background is the card, so
  this one has none.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Hidden by default: initCheckBox() only ever shows it when the adapter has
         checkboxesVisibility set, and starting out "visible" made the row jump on
         the very first bind. -->
    <CheckBox
        android:id="@+id/view_selectable_list_item_checkbox"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_margin="6dp"
        android:background="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/view_selectable_list_item_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="horizontal" />

</LinearLayout>
