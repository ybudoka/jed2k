<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:frostwire="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <org.dkf.jmule.views.SearchParametersView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/fragment_search_parameters"
        android:visibility="gone"
        />

    <ProgressBar
            android:id="@+id/fragment_search_deepsearch_progress"
            style="@style/ProgressBarHolo.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dip"
            android:indeterminate="true"
            android:progress="25"/>

    <org.dkf.jmule.views.SearchInputView
            android:id="@+id/fragment_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    <!--
      Quick filters. Hidden until there is something to filter - an empty bar over an
      empty screen is just clutter, and it would sit between the search box and the
      keyboard on first run.
    -->
    <org.dkf.jmule.views.SearchFiltersView
            android:id="@+id/fragment_search_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_page_background"
            android:visibility="gone"/>

    <org.dkf.jmule.views.RichNotification
            android:id="@+id/fragment_search_rating_reminder_notification"
            frostwire:rich_notification_icon="@null"
            frostwire:rich_notification_title="@string/server_not_connected"
            frostwire:rich_notification_title_underlined="true"
            frostwire:rich_notification_description="@string/server_not_connected_det"
            frostwire:rich_notification_number_of_action_links="0"
            frostwire:rich_notification_action_links_horizontal_margin="14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
    />

    <org.dkf.jmule.views.RichNotification
            android:id="@+id/fragment_search_safe_mode"
            frostwire:rich_notification_icon="@null"
            frostwire:rich_notification_title="@string/search_fragment_safe_mode_title"
            frostwire:rich_notification_title_underlined="true"
            frostwire:rich_notification_description="@string/search_fragment_safe_mode_descr"
            frostwire:rich_notification_number_of_action_links="0"
            frostwire:rich_notification_action_links_horizontal_margin="14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
    />

    <!-- An empty LinearLayout with a black background and wrap_content height used to
         sit here: it measured to zero and drew nothing, but it would have become a
         black bar the moment anything was added to it, and it is one more view for
         every layout pass to walk. -->

    <org.dkf.jmule.views.SwipeLayout
            android:id="@+id/fragment_search_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <FrameLayout
                android:id="@+id/fragment_search_framelayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <org.dkf.jmule.views.SearchProgressView
                    android:id="@+id/fragment_search_search_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

            <!-- divider/dividerHeight are off: the cards space themselves, and a
                 hairline between two floating cards reads as a mistake. clipToPadding
                 keeps the bottom card clear of the edge while still scrolling under
                 it. -->
            <ListView
                    android:id="@+id/fragment_search_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/app_page_background"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingBottom="@dimen/card_gap"
                    android:scrollbarStyle="outsideOverlay"
                    android:fastScrollEnabled="true"/>

            <!--
              Shown in place of the list when the filters have hidden every hit. The
              results are still there, which is exactly what is not obvious from a blank
              screen - so say so, and put the way out one tap away.
            -->
            <LinearLayout
                    android:id="@+id/fragment_search_filters_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/app_page_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="invisible">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/search_filter_none_match"
                        android:textColor="@color/app_text_primary"
                        android:textSize="@dimen/text_medium"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/search_filter_none_match_hint"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="@dimen/text_x_small"/>

                <TextView
                        android:id="@+id/fragment_search_filters_empty_clear"
                        style="@style/SearchFilterChip"
                        android:layout_marginTop="20dp"
                        android:text="@string/search_filter_clear"/>

            </LinearLayout>
        </FrameLayout>
    </org.dkf.jmule.views.SwipeLayout>

</LinearLayout>
